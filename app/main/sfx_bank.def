/* The sound bank (sfx task 2): chiptune voices only (NES, GB wave, YM2149 / AY), no PCM, no FM. Parsed once at boot into PSRAM
 * (sfx.c -> pc_sfx_bank_parse, components/player_core/src/pc_sfx_bank.c); host-tested as it is (test_sfx). Each line below is one C string, one
 * text line. An entry that needs anything the voices cannot do is refused at boot (console `sfx bank` shows the count, the log the reason).
 *
 * Format (one item a line; # starts a comment line):
 *   @credit <key> <text>                     who made what follows; every entry names one (docs/licenses/sfx-bank-credits.md)
 *   @wave <name> <32 hex digits>             a GB wave-channel table (32 x 4 bit)
 *   @entry <name> <group> <zh> <en> <credit> [tempo=<bpm>]
 *                                            name: what sfx_play() takes; group: ui toy game more (the 音效庫 page's headers); en: _ = space
 *   then 1..4 track lines, each one voice:
 *     <voice> [key=value ...]                a one-note recipe: f=<Hz> len=<ms> [to=<Hz> (slide) del=<ms> (start) vol=<0..15>]
 *     <voice> [key=value ...] | <MML>        a jingle track: t<bpm> o<octave> l<length>[.] v<0..15> q<gate 1..8> < > r a..g (+ # -) [length][.]
 *     zzfx <ZzFX parameter list>             a ZzFX recipe (v1.4 order; noise, modulation, bit crush, delay, tremolo, filter and the tan shape are
 *                                            refused; randomness is left out; shapeCurve < .6 on sine/triangle/saw becomes the 50 % pulse)
 *   voices: pulse (NES, duty=12|25|50|75), tri (NES, 4-bit steps), noise (NES LFSR, mode=long|short; f = its clock), wave (GB, tab=<table>),
 *           ay (AY tone, log volume), aynoise (AY 17-bit LFSR), aymix (AY tone AND noise, nhz=<noise clock>)
 *   keys (every voice): lvl=0..1 att= dec= (ms) sus=0..1 rel= (ms) | oct= (octaves/s) lin= (Hz/s) acc= (Hz/s^2) jump=<Hz> jt=<ms> rep=<ms> |
 *           arp=<semitones,..> arpms= | vib=<depth 0..0.5> vibhz= vibms= (delay) | env=<AY shape 0..15> envhz=
 * Levels: the tracks of an entry are scaled so their loudest notes sum to 1 (one entry peaks at -18 dBFS); the synth holds overlaps at -12 dBFS.
 * Melodies are original. No copied commercial game music: the "extra life", "level up" and "game over"-style entries are written "in that spirit". */
"@credit original Original sound for this project (JukeDial), 2026-11-14.\n"
"@credit task1 Original, the first sketches of sfx Task 1 (2026-11-14), moved into the bank unchanged in spirit.\n"
"@credit zzfx ZzFX by Frank Force, MIT licence, https://github.com/KilledByAPixel/ZzFX (README sample sounds).\n"
"@credit jsfxr jsfxr by Chris McCormick (Unlicense, public domain), https://github.com/chr15m/jsfxr: the middle of a preset generator's ranges, converted by hand (sfxr by DrPetter, MIT).\n"
"@wave sine 89ACDEEFFFEEDCA98653211000112356\n"
"@wave saw 00112233445566778899AABBCCDDEEFF\n"
"@wave organ 8BDEEDB98778889A9876556778777532\n"
"@wave soft 789ABCDEEDCBA9876543211234567778\n"
"# ---- ui ----\n"
"@entry tap ui 輕點 Tap original\n"
"pulse duty=25 f=1760 len=16 dec=16 sus=0 lvl=.5\n"
"@entry ok ui 確定 OK task1 tempo=214\n"
"pulse duty=50 att=2 dec=118 sus=0 lvl=.8 | o5 a16 >e8\n"
"@entry back ui 上一頁 Page_back original tempo=214\n"
"pulse duty=50 att=2 dec=68 sus=0 lvl=.7 | o5 e16 <a16\n"
"@entry error ui 錯誤 Error original tempo=180\n"
"pulse duty=12 att=1 rel=10 lvl=.8 | o3 c+16 r32 c+8\n"
"@entry fail ui 失敗 Fail task1\n"
"pulse duty=25 f=330 to=220 len=160 att=2 dec=158 sus=0 lvl=.8\n"
"pulse duty=25 f=220 to=150 del=170 len=220 att=2 dec=218 sus=0 lvl=.8\n"
"@entry select ui 選取 Select jsfxr\n"
"pulse duty=25 f=568 len=74 rel=23\n"
"# ---- toys ----\n"
"@entry pop toy 泡泡 Pop task1\n"
"noise f=8000 len=25 dec=25 sus=0 lvl=.45\n"
"pulse duty=50 f=1400 to=500 len=45 att=1 dec=44 sus=0 lvl=.55\n"
"@entry pop_big toy 大泡泡 Big_pop task1\n"
"noise f=6000 to=2000 len=60 dec=60 sus=0 lvl=.45\n"
"pulse duty=25 f=900 to=250 len=90 att=1 dec=89 sus=0 lvl=.55\n"
"tri f=1200 to=1600 del=60 len=120 att=5 dec=115 sus=0 lvl=.45\n"
"@entry tick toy 滴答 Tick task1\n"
"pulse duty=12 f=2400 len=12 dec=12 sus=0 lvl=.7\n"
"@entry stop toy 停輪 Reel_stop task1\n"
"tri f=300 to=180 len=70 dec=70 sus=0 lvl=.7\n"
"noise f=4000 len=20 dec=20 sus=0 lvl=.3\n"
"@entry win toy 贏 Win task1 tempo=214\n"
"pulse duty=50 att=2 dec=88 sus=0 lvl=.85 | o6 l16 c e g >c8.\n"
"@entry jackpot toy 大獎 Jackpot original tempo=220\n"
"pulse duty=50 att=1 dec=60 sus=.5 rel=40 lvl=.7 | o5 l16 c e g >c e g >c4 r16 <g16 >c2\n"
"pulse duty=25 att=1 dec=60 sus=.5 rel=40 lvl=.5 | o5 l16 e g >c e g >c e4 r16 d16 e2\n"
"tri att=1 rel=30 lvl=.8 | o3 l8 c g c g c4 r16 g16 >c2\n"
"noise mode=short att=0 dec=40 sus=0 lvl=.25 | o7 l8 c c c c c4 r16 c16 c2\n"
"@entry clack toy 木塊 Block task1\n"
"noise f=5000 len=35 dec=35 sus=0 lvl=.6\n"
"tri f=110 to=70 len=90 dec=90 sus=0 lvl=.4\n"
"noise f=3000 del=45 len=20 dec=20 sus=0 lvl=.3\n"
"@entry dice toy 骰子 Dice task1\n"
"noise f=7000 to=4000 len=30 dec=30 sus=0 lvl=.6\n"
"pulse duty=25 f=600 to=400 len=40 dec=40 sus=0 lvl=.4\n"
"@entry jiao_sheng toy 聖筊 Holy_yes original tempo=160\n"
"wave tab=sine att=2 dec=260 sus=.2 rel=80 lvl=.8 | o6 e8 b4.\n"
"tri att=2 dec=200 sus=.4 rel=80 lvl=.6 | o4 e8 b4.\n"
"@entry jiao_xiao toy 笑筊 Laughing original tempo=240\n"
"pulse duty=25 att=1 dec=40 sus=.3 rel=10 vib=.02 vibhz=9 lvl=.8 | o5 l32 e g e g e g >c8\n"
"@entry jiao_yin toy 陰筊 No original tempo=110\n"
"tri att=4 dec=200 sus=.3 rel=60 lvl=.8 | o4 e8 c4\n"
"wave tab=soft att=4 dec=200 sus=.2 rel=60 lvl=.4 | o5 e8 c4\n"
"# ---- games ----\n"
"@entry move game 移動 Move original\n"
"pulse duty=12 f=600 to=900 len=30 dec=30 sus=0 lvl=.5\n"
"@entry coin game 金幣 Coin jsfxr\n"
"wave tab=saw f=1494 jump=251 jt=73 dec=6 sus=.53 rel=204 len=210\n"
"@entry power_up game 能量 Power_up jsfxr\n"
"wave tab=saw f=436 oct=17.2 rep=73 rel=204 len=295\n"
"@entry jump game 跳 Jump jsfxr\n"
"pulse duty=25 f=718 oct=5.09 rel=91 len=233\n"
"@entry hit game 受傷 Hit jsfxr\n"
"noise f=28000 oct=-79 dec=6 sus=.6 rel=91 len=97\n"
"@entry laser game 雷射 Laser jsfxr\n"
"pulse duty=25 f=1988 oct=-9.94 rel=91 len=182\n"
"@entry boom game 爆炸 Explosion jsfxr\n"
"noise f=1027 oct=.6 dec=10 sus=.67 rel=142 len=294\n"
"@entry game_over game 結束 Game_over zzfx\n"
"zzfx ,,925,.04,.3,.6,1,.3,,6.27,-184,.09,.17\n"
"@entry heart game 愛心 Heart zzfx\n"
"zzfx ,,537,.02,.02,.22,1,1.59,-6.98,4.97\n"
"@entry lose game 輸 Lose original tempo=140\n"
"pulse duty=50 att=2 rel=40 vib=.015 vibhz=6 vibms=200 lvl=.7 | o5 g8 f+8 f8 e2\n"
"tri att=2 rel=40 lvl=.7 | o3 c4 <b4 a+2\n"
"@entry draw game 平手 Draw original tempo=180\n"
"pulse duty=25 att=2 dec=80 sus=.3 rel=20 lvl=.7 | o5 g8 r16 g8\n"
"tri att=2 dec=80 sus=.3 rel=20 lvl=.6 | o4 c8 r16 c8\n"
"@entry combo game 連擊 Combo original tempo=150\n"
"pulse duty=25 att=1 dec=150 sus=.2 rel=30 arp=0,4,7,12 arpms=25 lvl=.8 | o6 c4\n"
"@entry level_up game 升級 Level_up original tempo=200\n"
"pulse duty=50 att=1 dec=50 sus=.6 rel=30 lvl=.6 | o5 l16 c e g >c e g >c4\n"
"pulse duty=25 att=1 dec=50 sus=.6 rel=30 lvl=.45 | o4 l16 g >c e g >c e g4\n"
"tri att=1 rel=30 lvl=.7 | o3 l8 c g >c4 <c4\n"
"@entry extra_life game 加一命 Extra_life original tempo=280\n"
"pulse duty=50 att=1 dec=30 sus=.7 rel=20 lvl=.7 | o5 l16 a >c+ e a e a >c+4\n"
"pulse duty=12 att=1 dec=30 sus=.5 rel=20 lvl=.35 | o5 l16 e a >c+ e c+ e a4\n"
"@entry ready game 準備 Ready original tempo=120\n"
"pulse duty=50 att=1 dec=120 sus=0 lvl=.7 | o5 a8 r8 a8 r8 >a4\n"
"@entry sector_1 game 扇區一 Sector_1 original\n"
"pulse duty=50 f=659 len=300 att=4 dec=80 sus=.6 rel=60 lvl=.8\n"
"@entry sector_2 game 扇區二 Sector_2 original\n"
"pulse duty=50 f=554 len=300 att=4 dec=80 sus=.6 rel=60 lvl=.8\n"
"@entry sector_3 game 扇區三 Sector_3 original\n"
"pulse duty=50 f=440 len=300 att=4 dec=80 sus=.6 rel=60 lvl=.8\n"
"@entry sector_4 game 扇區四 Sector_4 original\n"
"pulse duty=50 f=330 len=300 att=4 dec=80 sus=.6 rel=60 lvl=.8\n"
"@entry warp game 傳送 Warp original\n"
"tri f=200 oct=6 rep=120 vib=.03 vibhz=12 rel=60 len=480\n"
"wave tab=organ f=400 oct=6 rep=120 rel=60 len=480 lvl=.5\n"
"@entry sparkle game 閃亮 Sparkle original tempo=240\n"
"pulse duty=12 att=1 dec=60 sus=0 arp=0,7,12,19 arpms=20 lvl=.6 | o6 l16 c e g >c8\n"
"@entry gold game 金色局 Golden_game original tempo=220\n"
"wave tab=sine att=1 dec=90 sus=.4 rel=60 lvl=.6 | o6 l16 e g+ b >e8 r16 <b16 >e4\n"
"pulse duty=12 att=1 dec=40 sus=0 arp=0,4,7,12 arpms=25 lvl=.35 | o5 l8 e r e r e4\n"
"# ---- more (the other chips' colours) ----\n"
"@entry bell more 鈴 Bell original tempo=120\n"
"ay env=0 envhz=2.5 lvl=.8 | o6 c4 g4\n"
"@entry chime more 叮咚 Ding_dong original tempo=100\n"
"wave tab=sine att=2 dec=400 sus=.3 rel=150 lvl=.9 | o6 e4 c2\n"
"@entry timer_warn more 倒數 Countdown_beep original tempo=240\n"
"pulse duty=50 att=1 dec=70 sus=0 lvl=.8 | o6 a8\n"
"@entry timer_end more 時間到 Time_up original tempo=200\n"
"pulse duty=50 att=1 dec=50 sus=.5 rel=20 lvl=.8 | o6 l16 a r a r a r8 a r a r a r8 >c4\n"
"pulse duty=25 att=1 dec=50 sus=.4 rel=20 lvl=.4 | o5 l16 e r e r e r8 e r e r e r8 g4\n"
"@entry buzz more 嗡嗡 Buzz original tempo=120\n"
"ay env=8 envhz=110 lvl=.8 | o5 a4\n"
"@entry engine more 引擎 Engine original\n"
"aymix nhz=3000 f=110 oct=1 len=900 att=40 rel=200 lvl=.8\n"
"@entry snare more 小鼓 Snare original\n"
"aynoise f=12000 len=120 dec=120 sus=0 lvl=.8\n"
"tri f=180 to=90 len=60 dec=60 sus=0 lvl=.5\n"
"@entry step more 腳步 Step original\n"
"noise mode=short f=3000 len=30 dec=30 sus=0 lvl=.6\n"
"@entry siren more 警報 Siren original\n"
"ay vib=.12 vibhz=3 att=50 rel=150 f=880 len=1400 lvl=.7\n"
"@entry organ more 風琴 Organ original tempo=140\n"
"wave tab=organ att=3 rel=40 lvl=.8 | o5 l8 c e g e c4\n"
